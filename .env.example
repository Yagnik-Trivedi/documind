# Copy to .env and fill in. NEVER commit .env.
# Every variable maps to a field in apps/api/app/config.py (case-insensitive).

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://documind:documind@localhost:5432/documind
AUTO_MIGRATE=true

# --- LLM: any OpenAI-compatible endpoint ------------------------------------
LLM_PROVIDER=openai_compat            # openai_compat | fake (offline, for tests/dev)

# Option A (default): Google Gemini, free key from Google AI Studio
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your-gemini-api-key-here
CHAT_MODEL=gemini-flash-latest        # pin an exact version (see scripts/list_models.py) before evals
FAST_MODEL=gemini-flash-lite-latest
EMBED_MODEL=gemini-embedding-001      # 3072 dims, truncated to EMBED_DIM (Matryoshka)
EMBED_DIM=768

# Option B: fully local with Ollama (comment out Option A above, uncomment these)
# LLM_BASE_URL=http://localhost:11434/v1/
# CHAT_MODEL=qwen2.5:14b
# FAST_MODEL=qwen2.5:7b
# EMBED_MODEL=bge-m3                  # ollama pull bge-m3
# EMBED_DIM=1024

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
# LLM_REASONING_EFFORT=low            # optional, for thinking models

# --- Embeddings ---------------------------------------------------------------
EMBED_PROVIDER=openai_compat          # openai_compat | local (BGE-M3 via sentence-transformers; uv sync --extra local) | fake
EMBED_TRUNCATE=true                   # cut larger Matryoshka outputs to EMBED_DIM
EMBED_SEND_DIMENSIONS=false           # also send `dimensions` (works with OpenAI text-embedding-3)
# EMBED_BASE_URL=                     # defaults to LLM_BASE_URL
# EMBED_API_KEY=                      # defaults to the LLM key
# LOCAL_EMBED_MODEL=BAAI/bge-m3       # 1024 dims
# EMBED_DIM is fixed by the first migration. Changing it later = docker compose down -v + re-ingest.

# --- Retrieval ----------------------------------------------------------------
TS_CONFIG=simple                      # 'english' for English-only corpora (stemming); set BEFORE first migration
RETRIEVE_K=40
CONTEXT_K=8
RRF_K=60
HNSW_EF_SEARCH=100

# --- Files / web ----------------------------------------------------------------
STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:3000
DEFAULT_WORKSPACE=public

# --- Tests (set in your shell, not here) ------------------------------------------
# TEST_DATABASE_URL=postgresql://documind:documind@localhost:5432/documind_test   (its schema gets wiped!)

# --- Web app (apps/web) ---------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
